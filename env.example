# PsTuts RAG Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# CORE APPLICATION CONFIGURATION
# =============================================================================

# EVA Workflow Configuration
EVA_WORKFLOW_NAME=EVA_workflow
EVA_LOG_LEVEL=INFO
EVA_STRIP_THINK=true
EVA_SEARCH_PERMISSION=ask
EVA_DB_PERSIST=qdrant
EVA_REINITIALIZE=False

# point at your dataset
TRANSCRIPT_GLOB=./data/train.json:./data/dev.json:./data/test.json

# AI system config
MAX_RESEARCH_LOOPS=4
N_CONTEXT_DOCS=3

# Model Configuration
EMBEDDING_API=OLLAMA
EMBEDDING_MODEL=mxbai-embed-large
LLM_API=OPENAI
LLM_TOOL_MODEL=gpt-4.1-mini

# Session Configuration
THREAD_ID=

# =============================================================================
# API KEYS (REQUIRED FOR MAIN APPLICATION)
# =============================================================================

# OpenAI API Key (required when LLM_API=OPENAI)
OPENAI_API_KEY=your-openai-api-key-here

# LangSmith Tracing (optional but recommended for debugging)
LANGCHAIN_API_KEY=your-langchain-api-key-here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=EnhancedVideoArchive

# Ollama Configuration (required when using OLLAMA APIs)
OLLAMA_HOST=http://localhost:11434

# Web Search
# TAVILY_API_KEY=your-tavily-api-key-here

# =============================================================================
# OPTIONAL API KEYS 
# =============================================================================

# HuggingFace (used in notebooks for model fine-tuning)
# HF_TOKEN=your-huggingface-token-here
# HF_USER=your-huggingface-username

# Weights & Biases (used in notebooks for experiment tracking)
# WANDB_API_KEY=your-wandb-api-key-here

# RAGAS (used in notebooks for evaluation)
# RAGAS_APP_TOKEN=your-ragas-app-token-here
